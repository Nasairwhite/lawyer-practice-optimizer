# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=https://your-public-host.example.com

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15555550123
# Optional: existing Proxy Service SID; if blank, one will be created on first use
TWILIO_PROXY_SERVICE_SID=

# --- Anthropic (Claude) ---
# Note: "Claude Pro Max" is a chat subscription on claude.ai and does NOT grant API access.
# Get an API key from https://console.anthropic.com/ (billed separately).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=1024

# --- Behavior ---
# Set to "true" to have Claude auto-reply to inbound SMS, or "false" to only relay.
CLAUDE_AUTOREPLY=true
# System prompt used when CLAUDE_AUTOREPLY=true
CLAUDE_SYSTEM_PROMPT="You are a concise SMS assistant. Keep replies under 320 characters."

# --- Webhook relay (optional) ---
# Comma-separated list of downstream URLs to fan-out Twilio webhooks to
RELAY_DOWNSTREAM_URLS=
